# ==========================================================
# Project 06 - Development Dockerfile
# ==========================================================
#
# 這個 Image 專門提供 Development Container 使用。
#
# 主要負責：
#
# - 固定 Node.js 版本
# - 安裝 npm dependencies
# - 安裝 devDependencies
# - 提供 TypeScript / tsx 等開發工具
#
# Source Code 在真正開發時，
# 會由 compose.dev.yaml 使用 bind mount 掛載進 /app。
#
# ==========================================================


# ----------------------------------------------------------
# 1. Node.js Base Image
# ----------------------------------------------------------
#
# 使用 Node.js 24。
#
# bookworm-slim：
#
# - Debian Bookworm
# - 比完整 Node image 精簡
# - 適合作為一般 Node.js 開發環境
#
FROM node:24-bookworm-slim


# ----------------------------------------------------------
# 2. Working Directory
# ----------------------------------------------------------
#
# Container 裡面的專案工作目錄。
#
# 後面的 RUN、COPY、CMD 都會以 /app 為基礎。
#
WORKDIR /app


# ----------------------------------------------------------
# 3. Copy npm Dependency Files
# ----------------------------------------------------------
#
# 先只複製：
#
# package.json
# package-lock.json
#
# 讓 Docker 可以利用 build cache。
#
# 如果只有 src/ 程式碼改變，
# package-lock.json 沒變，
# npm ci 這一層就有機會使用 cache。
#
COPY package.json package-lock.json ./


# ----------------------------------------------------------
# 4. Install Development Dependencies
# ----------------------------------------------------------
#
# npm ci：
#
# 根據 package-lock.json 安裝固定版本的套件。
#
# Development 需要：
#
# dependencies
# +
# devDependencies
#
# 因此這裡不能使用：
#
# npm ci --omit=dev
#
RUN npm ci


# ----------------------------------------------------------
# 5. Default Development Environment
# ----------------------------------------------------------
#
# 設定 Development 環境。
#
# compose.dev.yaml 也會再明確設定一次，
# 方便直接從 Compose 看出目前環境。
#
ENV NODE_ENV=development


# ----------------------------------------------------------
# 6. Application Port
# ----------------------------------------------------------
#
# Express 使用 3000 port。
#
# EXPOSE 只是 Image metadata，
# 真正 Host → Container port mapping
# 由 Compose 的 ports 負責。
#
EXPOSE 3000


# ----------------------------------------------------------
# 7. Development Startup Command
# ----------------------------------------------------------
#
# package.json：
#
# "dev": "tsx watch src/app.ts"
#
# Container 啟動後執行 Development Server。
#
CMD ["npm", "run", "dev"]